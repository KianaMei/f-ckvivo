# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编译产物
*.o
build/
*.aarch64

# 上游研究缓存（GKI 镜像/ELF、他人复现仓库克隆，很大）
root/.upstream/
.upstream/
# OriginOS 上游参考模块的只读克隆（各自带 .git，不是本仓库产物）
originos/

# 大件产物 / 存档（只留本地）
douyin/apk/
douyin/work/
modules/*/apk/
modules/*/build/
modules/*/dist/
modules/*/.signing/
!modules/drag-all/.signing/
!modules/drag-all/.signing/**
modules/*/logs/
modules/*/shots/
modules/*/analysis/

# 本机运行产物
root/tools/proxy_log.txt
root/logs/*.zip
root/logs/*.png

# 编译出来的本地工具二进制
coolapk/tools/memdump
profile_out.bin

# 酷安逆向产物（APK / 解包 / 导出 dump / 签名材料，都只留本地）
coolapk/apk/
coolapk/work/
coolapk/backup/
coolapk/**/.signing/
coolapk/**/dist/
coolapk/**/build/

# Windows/git 工具崩溃转储
*.stackdump

# Vector 软重启崩溃取证（大件只留本地）
root/vector-softreboot/device/daemon.apk
root/vector-softreboot/device/apk/
root/vector-softreboot/device/kmsg_old.log
root/vector-softreboot/device/*.err

# 临时工作区 / 本机工具链（只留本地，不入库）
_tmp_*/
_tools/
.zcode/

# 抖音逆向大件（dex 索引 sqlite、宿主 APK 样本，只留本地）
douyin/analysis/
# 根目录工具链（jadx / platform-tools，只留本地）
/tools/
