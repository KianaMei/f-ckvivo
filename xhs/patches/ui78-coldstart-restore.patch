+                    diagContext = c;
+                }
+            } catch (Throwable ignored) {
+            }
+        }
+        if (c != null) {
+            try {
+                target = new java.io.File(c.getFilesDir(), "ui78-diag.log");
+                if (!target.getParentFile().exists()) {
+                    target = null;
+                }
+            } catch (Throwable ignored) {
