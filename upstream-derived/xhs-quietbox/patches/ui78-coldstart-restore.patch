diff --git a/app/src/test/java/com/quietbox/app/hooks/ColdStartFeedRequestTest.java b/app/src/test/java/com/quietbox/app/hooks/ColdStartFeedRequestTest.java
new file mode 100644
index 0000000..6c7c1cd
--- /dev/null
+++ b/app/src/test/java/com/quietbox/app/hooks/ColdStartFeedRequestTest.java
@@ -0,0 +1,51 @@
+package com.quietbox.app.hooks;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ColdStartFeedRequestTest {
+    @Test
+    public void keepsColdStartFirstPageForBothSources() {
+        assertTrue(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "''", "1"), 265L));
+        assertTrue(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("WK_CACHE_REFRESH", 0, "null", "1"), 120_000L));
+    }
+
+    @Test
+    public void allowsUserRefreshAndPaginationDuringStartup() {
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("PULL_REFRESH", 0, "''", "1"), 500L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "''", "null"), 500L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("LOAD_MORE", 10, "'cursor'", "null"), 500L));
+    }
+
+    @Test
+    public void requiresExactScenarioFirstPageAndEmptyCursor() {
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "''", "10"), 500L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 1, "''", "1"), 500L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "'cursor'", "1"), 500L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH_RETRY", 0, "''", "1"), 500L));
+    }
+
+    @Test
+    public void allowsRequestsOutsideStartupWindow() {
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "''", "1"), 120_001L));
+        assertFalse(HomeFeedRefreshHooks.shouldKeepColdStartFeed(
+                request("INITIAL_REFRESH", 0, "''", "1"), -1L));
+    }
+
+    private static String request(String source, int index, String cursor, String scenario) {
+        return "HomeFeedParam(channel='homefeed_recommend', refreshSource=" + source
+                + ", cursorScore=" + cursor + ", noteIndex=" + index + ", launchScenario=" + scenario + ")";
+    }
+}
