+    private static volatile long lastShareAtMs;
+
+    private ShareQqHooks() {
+    }
+
+    static void install(XposedModule module, ClassLoader cl) {
+        Feature f = Feature.SHARE_QQ_RESTORE;
+        try {
+            Method list = HookKit.findAnchorMethod(module, f, cl,
+                    AnchorKeys.SHARE_PANEL_LIST, true);
+            HookKit.install(module, f, "sharePanelList", list, listHook(module, f));
+
+            Method byType = HookKit.findAnchorMethod(module, f, cl,
+                    AnchorKeys.SHARE_PANEL_CLICK_TYPE, false);
+            HookKit.install(module, f, "sharePanelAttachType", byType, attachHook(module, f));
+
+            Method byView = HookKit.findAnchorMethod(module, f, cl,
+                    AnchorKeys.SHARE_PANEL_CLICK_VIEW, false);
+            HookKit.install(module, f, "sharePanelAttach", byView, attachHook(module, f));
+
+            Method click1 = HookKit.findAnchorMethod(module, f, cl,
+                    AnchorKeys.SHARE_CLICK_LAMBDA_1, true);
+            HookKit.install(module, f, "shareClickLambda1", click1, clickHook(module, f));
+
+            Method click2 = HookKit.findAnchorMethod(module, f, cl,
+                    AnchorKeys.SHARE_CLICK_LAMBDA_2, false);
+            HookKit.install(module, f, "shareClickLambda2", click2, clickHook(module, f));
+
+            HookState.note(f, "分享面板补回 QQ（注入条目 + 系统 Intent），实验功能");
+        } catch (Throwable t) {
+            HookKit.error(module, f.id + " install aborted", t);
+        }
+    }
+
+    private static XposedInterface.Hooker listHook(XposedModule module, Feature f) {
+        return new XposedInterface.Hooker() {
+            @Override
+            public Object intercept(XposedInterface.Chain chain) throws Throwable {
+                Object result = chain.proceed();
+                try {
+                    Object panel = chain.getThisObject();
+                    captureEntity(panel);
+                    return inject(module, f, panel, result);
+                } catch (Throwable t) {
+                    return result;
+                }
+            }
+        };
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Object inject(XposedModule module, Feature f, Object panel, Object result) {
+        if (!(result instanceof List)) {
+            return result;
+        }
+        List<Object> items = (List<Object>) result;
+        StringBuilder ids = new StringBuilder();
+        for (Object item : items) {
+            ids.append(itemId(item)).append('|');
+        }
+
+        for (Object item : items) {
+            String id = itemId(item);
+            if (MARK.equals(id) || QQ_TYPE.equals(id)) {
+                return items;
+            }
+        }
+        Object made = newQqItem(panel);
+        if (made == null) {
+            return items;
+        }
+        if (!renameId(made, QQ_TYPE, MARK)) {
+            return items;
+        }
+        List<Object> out = new ArrayList<>(items);
+        out.add(made);
+        HookKit.hit(module, f, "注入 QQ 条目");
+        return out;
+    }
+
+    private static Object newQqItem(Object panel) {
+        try {
+            Method factory = HookKit.anchorMethod(
+                    panel.getClass().getClassLoader(), AnchorKeys.SHARE_ITEM_FACTORY);
+            if (factory == null) {
+                return null;
+            }
+            return factory.invoke(null, QQ_TYPE, null, null, null, false, 30, null);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /** 把条目的 id 字段从 QQ_TYPE 改成内部标记，避开宿主的硬过滤。 */
+    private static boolean renameId(Object item, String from, String to) {
+        Class<?> c = item.getClass();
+        while (c != null && c != Object.class) {
+            for (Field field : c.getDeclaredFields()) {
+                if (field.getType() != String.class) {
+                    continue;
+                }
+                try {
+                    field.setAccessible(true);
+                    if (from.equals(field.get(item))) {
+                        field.set(item, to);
+                        return true;
+                    }
+                } catch (Throwable ignored) {
+                }
+            }
+            c = c.getSuperclass();
+        }
+        return false;
+    }
+
+    private static String itemId(Object item) {
+        if (item == null) {
+            return "null";
+        }
+        try {
+            Method getId = item.getClass().getMethod("getId");
+            Object v = getId.invoke(item);
+            return v instanceof String ? (String) v : "?";
+        } catch (Throwable ignored) {
+            return "?";
+        }
+    }
+
+    private static void captureEntity(Object panel) {
+        if (panel == null) {
+            return;
+        }
+        for (Field field : panel.getClass().getDeclaredFields()) {
+            if (!field.getType().getName().equals("com.xingin.entities.share.ShareEntity")) {
+                continue;
+            }
+            try {
+                field.setAccessible(true);
+                Object v = field.get(panel);
+                if (v != null) {
+                    shareEntity = v;
+                    return;
+                }
+            } catch (Throwable ignored) {
+            }
+        }
+    }
+
+    /** 条目 onAttachedToWindow 回调：只做诊断，不触发分享。 */
+    private static XposedInterface.Hooker attachHook(XposedModule module, Feature f) {
+        return new XposedInterface.Hooker() {
+            @Override
+            public Object intercept(XposedInterface.Chain chain) throws Throwable {
+                try {
+                } catch (Throwable t) {
+                }
+                return chain.proceed();
+            }
+        };
+    }
+
+    /** 点击 lambda：参数里出现我们的标记条目时才接管。 */
+    private static XposedInterface.Hooker clickHook(XposedModule module, Feature f) {
+        return new XposedInterface.Hooker() {
+            @Override
+            public Object intercept(XposedInterface.Chain chain) throws Throwable {
+                try {
+                    Object marker = findMarker(chain.getArgs());
+                    if (marker != null) {
+                        Context ctx = appContext();
+                        if (shareToQq(module, f, ctx)) {
+                            return null;
+                        }
+                    }
+                } catch (Throwable t) {
+                }
+                return chain.proceed();
+            }
+        };
+    }
+
+    /** 参数（或参数内部字段）出现内部标记 → 认为点的是我们注入的条目。 */
+    private static Object findMarker(java.util.List<Object> args) {
+        for (Object arg : args) {
+            if (arg == null) {
+                continue;
+            }
+            if (arg instanceof String) {
+                if (MARK.equals(arg)) {
+                    return arg;
+                }
+                continue;
+            }
+            Class<?> c = arg.getClass();
+            while (c != null && c != Object.class) {
+                for (Field field : c.getDeclaredFields()) {
+                    if (field.getType() != String.class) {
+                        continue;
+                    }
+                    try {
+                        field.setAccessible(true);
+                        Object v = field.get(arg);
+                        if (MARK.equals(v)) {
+                            return arg;
+                        }
+                    } catch (Throwable ignored) {
+                    }
+                }
+                c = c.getSuperclass();
+            }
+        }
+        return null;
+    }
+
+    private static Context appContext() {
+        try {
+            Class<?> activityThread = Class.forName("android.app.ActivityThread");
+            Object app = activityThread.getMethod("currentApplication").invoke(null);
+            return app instanceof Context ? (Context) app : null;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    private static Context contextOf(Object self) {
+        if (self instanceof View) {
+            return ((View) self).getContext();
+        }
+        if (self instanceof Context) {
+            return (Context) self;
+        }
+        return null;
+    }
+
+    private static boolean shareToQq(XposedModule module, Feature f, Context ctx) {
+        long now = System.currentTimeMillis();
+        if (now - lastShareAtMs < 800) {
+            return true;
+        }
+        lastShareAtMs = now;
+        String url = findUrl(shareEntity);
+        String title = findTitle(shareEntity, url);
+        if (url == null || url.isEmpty()) {
+            if (ctx != null) {
+                Toast.makeText(ctx, "静盒：没抓到分享链接", Toast.LENGTH_SHORT).show();
+            }
+            return false;
+        }
+        if (ctx == null) {
+            return false;
+        }
+        String text = title == null || title.isEmpty() ? url : title + "\n" + url;
+        try {
+            Intent intent = new Intent(Intent.ACTION_SEND);
+            intent.setType("text/plain");
+            intent.putExtra(Intent.EXTRA_TEXT, text);
+            intent.setPackage(QQ_PKG);
+            if (!(ctx instanceof android.app.Activity)) {
+                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            }
+            ctx.startActivity(intent);
+            HookKit.hit(module, f, "QQ 分享已发出");
+            return true;
+        } catch (Throwable t) {
+            Toast.makeText(ctx, "静盒：QQ 分享失败（" + t.getClass().getSimpleName() + "）",
+                    Toast.LENGTH_SHORT).show();
+            return false;
+        }
+    }
+
+    private static String findUrl(Object entity) {
+        for (String s : strings(entity)) {
+            String lower = s.toLowerCase();
+            if (lower.startsWith("http") && (lower.contains("xiaohongshu")
+                    || lower.contains("xhslink") || lower.contains("xhs.cn"))) {
+                return s;
+            }
+        }
+        return null;
+    }
+
+    private static String findTitle(Object entity, String url) {
+        for (String s : strings(entity)) {
+            if (s.equals(url) || s.startsWith("http")) {
+                continue;
+            }
+            String trimmed = s.trim();
+            if (trimmed.length() >= 2 && trimmed.length() <= 80) {
+                return trimmed;
+            }
+        }
+        return null;
+    }
+
+    private static List<String> strings(Object entity) {
+        List<String> out = new ArrayList<>();
+        if (entity == null) {
+            return out;
+        }
+        Class<?> c = entity.getClass();
+        while (c != null && c != Object.class) {
+            for (Field field : c.getDeclaredFields()) {
+                if (field.getType() != String.class) {
+                    continue;
+                }
+                try {
+                    field.setAccessible(true);
+                    Object v = field.get(entity);
+                    if (v instanceof String && !((String) v).isEmpty()) {
+                        out.add((String) v);
+                    }
+                } catch (Throwable ignored) {
+                }
+            }
+            c = c.getSuperclass();
+        }
+        return out;
+    }
+
+    private static String currentProcessName() {
+        try {
+            Class<?> activityThread = Class.forName("android.app.ActivityThread");
+            return String.valueOf(activityThread.getMethod("currentProcessName").invoke(null));
+        } catch (Throwable t) {
+            return "?";
+        }
+    }
+
+
+
+}
